.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
credentials.json
segredos.json
secrets.json
*.secret
*_token.txt

# ---------------------------------------------------------------------------
# Contexto de agente/IA -- instrucao de maquina, nao documentacao de humano.
