# ---------------------------------------------------------------------------
CLAUDE.md
CLAUDE.local.md
AGENTS.md
GEMINI.md
.claude/
.cursor/
.cursorrules
.aider*
.github/copilot-instructions.md

# ---------------------------------------------------------------------------
# Ambiente e caches
# venv: este repo NAO tem o seu -- usa o do smart-traffic (ver README)
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
*.egg-info/
build/
dist/

# ---------------------------------------------------------------------------
# Saidas de run: os checkpoints campeoes vao versionados (results/), o resto nao
# ---------------------------------------------------------------------------
experiments/*/checkpoints/ckpt_*.pt
# corridas de fumaca: existem para provar que o pipeline sobe, nao para guardar
experiments/_smoke*/
results/rl/smoke*.pt
*.log
*.tmp

# SUMO
*.net.xml.bak
sumo/**/*.dump.xml

# so os .rou.xml GERADOS ficam de fora; o MANIFESTO deles vai versionado, e e ele
# que prova a reprodutibilidade (ver docs/CONTRATOS.md, C2).
sumo/aberta/demanda/*.rou.xml
!sumo/aberta/demanda/*.manifesto.json

# diarios de campanha do A8: duplicata dos .json ao lado, e sao grandes
results/a8/*.jsonl

# capturas soltas na raiz (as de validacao vao em docs/validation/)
/Screenshot*.png
/screenshot*.png

# saida mis-pathed: veio de um `--grava results/jogo/rodadas` (caminho_gravacao ja
# poe o /rodadas, entao aninhou duas vezes). Fica em disco, fora do repo.
results/jogo/rodadas/rodadas/

# a variante do relatorio para publicar como Artifact: mesmo conteudo do
# relatorio.html, so o envelope muda, e sai de `python scripts/relatorio_validacao.py`.
# Versionar as duas dobraria 1,2 MB por nada.
docs/validation/relatorio.artifact.html
